@model U360Prospect.Models.PagedResult<U360Prospect.Models.Prospect>

<div class="container-fluid">

    @if (TempData["UploadMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["UploadMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Prospect Management</h2>
            <p class="text-muted mb-0">
                Manage and maintain prospect information
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Download" class="btn btn-outline-success">
                ↓ Download Excel
            </a>

            <a asp-action="Upload" class="btn btn-outline-primary">
                ↑ Upload Excel
            </a>

            <a asp-action="Create" class="btn btn-success">
                + Add New Prospect
            </a>

        </div>

    </div>


    <!-- Search & Filter Section -->
<!-- Search & Filter Section -->
<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-2 align-items-center">

                <div class="col-md-5">
                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search prospect, industry, company type or region..." />
                </div>

                <div class="col-md-2">

                    <select name="region" class="form-select">

                        <option value="">All Regions</option>



			@foreach (var item in ViewBag.Regions)
{
    if (ViewBag.Region != null &&
        ViewBag.Region.ToString() == item.ToString())
    {
        <option value="@item" selected>@item</option>
    }
    else
    {
        <option value="@item">@item</option>
    }
}

                    </select>

                </div>

                <div class="col-md-2">

                    <select name="companyType" class="form-select">

                        <option value="">All Company Types</option>

			@foreach (var item in ViewBag.CompanyTypes)
{
    if (ViewBag.CompanyType != null &&
        ViewBag.CompanyType.ToString() == item.ToString())
    {
        <option value="@item" selected>@item</option>
    }
    else
    {
        <option value="@item">@item</option>
    }
}

                    </select>

                </div>

                <div class="col-md-3 d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>

</div>

    <!-- Prospect Grid -->
    <div class="card shadow-sm">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Prospect List
            </h5>

            <span class="badge bg-primary">
                @Model.TotalCount Record@(Model.TotalCount == 1 ? "" : "s")
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>ID</th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-region="@ViewBag.Region"
                                   asp-route-pageNumber="1"
                                   asp-route-sortColumn="ProspectName"
                                   asp-route-sortDirection="@(ViewBag.SortColumn == "ProspectName" && ViewBag.SortDirection == "asc" ? "desc" : "asc")"
                                   class="text-decoration-none text-white">

                                    Prospect Name

                                    @if (ViewBag.SortColumn == "ProspectName")
                                    {
                                        @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                                    }
                                    else
                                    {
                                        <span>↕</span>
                                    }

                                </a>
                            </th>

                            <th>Industry</th>
                            <th>Company Type</th>
                            <th style="min-width: 220px;">Address</th>
                            <th class="text-nowrap">Email</th>
                            <th class="text-nowrap">Phone No.</th>
                            <th class="text-nowrap">Load By</th>
                            <th class="text-nowrap">Load By</th>
			    <th class="text-nowrap" style="min-width: 120px;">
  			     Load Date
			    </th>
                            <th class="text-center text-nowrap">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Items.Any())
                        {
                            @foreach (var prospect in Model.Items)
                            {
                                <tr>

                                    <td>@prospect.Id</td>

                                    <td class="fw-semibold">
                                        @prospect.ProspectName
                                    </td>

                                    <td>@prospect.Industry</td>

                                    <td class="text-nowrap">
                                        @prospect.CompanyType
                                    </td>

                                    <td style="min-width: 220px; max-width: 300px;">
                                        @prospect.Address
                                    </td>

                                    <td class="text-nowrap">
                                        @prospect.Email
                                    </td>

                                    <td class="text-nowrap">
                                        @prospect.PhoneNumber
                                    </td>

                                    <td class="text-nowrap">
                                        @prospect.Region
                                    </td>

                                    <td class="text-nowrap">
                                        @prospect.LoadBy
                                    </td>

				    <td class="text-nowrap" style="min-width: 120px;">
				    @(prospect.LoadDate?.ToString("dd-MMM-yyyy") ?? "-")
				    </td>				

                                    <td class="text-center text-nowrap">

                                        <a asp-action="Edit"
                                           asp-route-id="@prospect.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@prospect.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="11"
                                    class="text-center text-muted py-4">
                                    No prospects found.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@if (Model != null && Model.TotalCount > 0)
{
    var startRecord = ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var endRecord = Math.Min(
        Model.PageNumber * Model.PageSize,
        Model.TotalCount
    );

    <div class="text-muted text-center mt-3">
        Showing @startRecord–@endRecord of @Model.TotalCount records
    </div>
}


            @if (Model != null && Model.TotalPages > 1)

	    {
	    <nav class="mt-4">

       	     <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-region="@ViewBag.Region"
                   asp-route-companyType="@ViewBag.CompanyType"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">
                    Previous
                </a>

            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchTerm="@ViewBag.SearchTerm"
                       asp-route-region="@ViewBag.Region"
                       asp-route-companyType="@ViewBag.CompanyType"
                       asp-route-pageNumber="@i">
                        @i
                    </a>

                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-region="@ViewBag.Region"
                   asp-route-companyType="@ViewBag.CompanyType"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">
                    Next
                </a>

            </li>

        </ul>

    </nav>
}
