@model U360Prospect.Models.PagedResult<U360Prospect.Models.Prospect>

<div class="container-fluid">

    @if (TempData["UploadMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["UploadMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- Page Header -->

<div class="d-flex flex-column flex-xl-row
            justify-content-between align-items-start
            gap-3 mb-4">

    <!-- Page heading -->
    <div>
        <h2 class="mb-1">Prospect Management</h2>
        <p class="text-muted mb-0">
            Manage and maintain prospect information
        </p>
    </div>

    <!-- Action buttons -->
    <div class="d-flex flex-wrap gap-2 align-items-center">

        <a asp-action="Download"
           asp-route-searchTerm="@ViewBag.SearchTerm"
           asp-route-country="@ViewBag.Country"
           asp-route-region="@ViewBag.Region"
           asp-route-prospectType="@ViewBag.ProspectType"
	   asp-route-industry="@ViewBag.Industry"
           asp-route-ubaCustomer="@ViewBag.UbaCustomer"
           class="btn btn-outline-success text-nowrap">
            ↓ Download Excel
        </a>

        @if (User.IsInRole("ADMIN"))
        {
            <a asp-action="Upload"
               class="btn btn-outline-primary text-nowrap">
                ↑ Upload Excel
            </a>
        }

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-primary text-nowrap">
            📊 Dashboard
        </a>

        <a asp-action="Create"
           class="btn btn-success text-nowrap">
            + Add New Prospect
        </a>

    </div>

</div>

     <!-- Search & Filter Section -->
<form asp-action="Index"
      method="get">

    <div class="row g-2 align-items-center">

    <!-- Search -->
    <div class="col-md-2">
        <input type="text"
               name="searchTerm"
               value="@ViewBag.SearchTerm"
               class="form-control"
               placeholder="Search company, prospect, industry, type or country..." />
    </div>

    <!-- Country -->
    <div class="col-md">
        <select name="country" class="form-select">
            <option value="">All Countries</option>

            @foreach (var item in ViewBag.Countries)
            {
                if (string.Equals(
                    Convert.ToString(ViewBag.Country),
                    item.Code,
                    StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@item.Code" selected>
                        @item.DisplayName
                    </option>
                }
                else
                {
                    <option value="@item.Code">
                        @item.DisplayName
                    </option>
                }
            }
        </select>
    </div>

    <!-- Region -->
    <div class="col-md">
        <select name="region" class="form-select">
            <option value="">All Regions</option>

            @foreach (var item in ViewBag.Regions)
            {
                if (ViewBag.Region != null &&
                    ViewBag.Region.ToString() == item.ToString())
                {
                    <option value="@item" selected>
                        @item
                    </option>
                }
                else
                {
                    <option value="@item">
                        @item
                    </option>
                }
            }
        </select>
    </div>

    <!-- Prospect Type -->
    <div class="col-md">
        <select name="prospectType" class="form-select">
            <option value="">All Prospect Types</option>

            @foreach (var item in ViewBag.ProspectTypes)
            {
                if (ViewBag.ProspectType != null &&
                    ViewBag.ProspectType.ToString() == item.ToString())
                {
                    <option value="@item" selected>
                        @item
                    </option>
                }
                else
                {
                    <option value="@item">
                        @item
                    </option>
                }
            }
        </select>
    </div>

    <!-- Industry -->
    <div class="col-md">
        <select name="industry" class="form-select">
            <option value="">All Industries</option>

            @foreach (var item in ViewBag.Industries)
            {
                if (ViewBag.Industry != null &&
                    ViewBag.Industry.ToString() == item.ToString())
                {
                    <option value="@item" selected>
                        @item
                    </option>
                }
                else
                {
                    <option value="@item">
                        @item
                    </option>
                }
            }
        </select>
    </div>

    <!-- Prospect Status -->
    <div class="col-md">
        <select name="ubaCustomer" class="form-select">
            <option value="">All Prospects</option>

            <option value="Yes"
                    selected="@(ViewBag.UbaCustomer == "Yes")">
                UBA Customers
            </option>

            <option value="No"
                    selected="@(ViewBag.UbaCustomer == "No")">
                Non-UBA Customers
            </option>
        </select>
    </div>

    <!-- Search Button -->
    <div class="col-auto">
        <button type="submit" class="btn btn-danger">
            Search
        </button>
    </div>

    <!-- Clear Button -->
    <div class="col-auto">
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Clear
        </a>
    </div>

</div>
            </form>

        </div>

    </div>


    <!-- Prospect Grid -->
    <div class="card shadow-sm">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Prospect List
            </h5>

            <span class="badge bg-primary">
                @Model.TotalCount
                Record@(Model.TotalCount == 1 ? "" : "s")
            </span>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

            <table class="table table-hover table-striped mb-0">

    <thead class="table-dark">

        <tr>

            <!-- Country -->
            <th>
                <a asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-country="@ViewBag.Country"
                   asp-route-region="@ViewBag.Region"
                   asp-route-prospectType="@ViewBag.ProspectType"
                   asp-route-ubaCustomer="@ViewBag.UbaCustomer"
                   asp-route-pageNumber="1"
                   asp-route-sortColumn="Country"
                   asp-route-sortDirection="@(ViewBag.SortColumn == "Country" && ViewBag.SortDirection == "asc" ? "desc" : "asc")"
                   class="text-decoration-none text-white">

                    Country

                    @if (ViewBag.SortColumn == "Country")
                    {
                        @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                    }
                    else
                    {
                        <span>↕</span>
                    }

                </a>
            </th>


            <!-- Prospect Name -->
            <th>
                <a asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-country="@ViewBag.Country"
                   asp-route-region="@ViewBag.Region"
                   asp-route-prospectType="@ViewBag.ProspectType"
                   asp-route-ubaCustomer="@ViewBag.UbaCustomer"
                   asp-route-pageNumber="1"
                   asp-route-sortColumn="ProspectName"
                   asp-route-sortDirection="@(ViewBag.SortColumn == "ProspectName" && ViewBag.SortDirection == "asc" ? "desc" : "asc")"
                   class="text-decoration-none text-white">

                    Prospect Name

                    @if (ViewBag.SortColumn == "ProspectName")
                    {
                        @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                    }
                    else
                    {
                        <span>↕</span>
                    }

                </a>
            </th>


            <th>Prospect Type</th>

	    <th> Industry </th>


            <!-- Customer Status -->
            <th class="text-center text-nowrap">
                Customer Status
            </th>


            <!-- Acquisition Status -->
            <th class="text-nowrap">
                Acquisition Status
            </th>

	    <!-- Funded -->
            <th class="text-nowrap">
               Funded
            </th>


            <!-- Marketed By -->
            <th class="text-nowrap">
                Marketed By
            </th>


            <!-- Marketed Date -->
            <th class="text-nowrap">
                Marketed Date
            </th>

	    <th style="min-width: 130px;">Branch ID</th>
            <th style="min-width: 140px;">Uploaded Date</th>
            <th style="min-width: 140px;">Converted Date</th>
            <th style="min-width: 130px;">Conversion Days</th>


            <th style="min-width: 220px;">
                Address
            </th>


            <th>State</th>


            <th>Region</th>


            <th class="text-nowrap">
                Phone
            </th>


            <th class="text-nowrap">
                Email
	    </th>



           <th class="text-center text-nowrap actions-column">
               Actions

</th>

        </tr>

    </thead>


    <tbody>

        @if (Model != null && Model.Items.Any())
        {
            @foreach (var prospect in Model.Items)
            {
                <tr>

                    <td class="text-nowrap">
                        @(U360Prospect.Models.CountryCatalog.All.FirstOrDefault(
    c => string.Equals(
        c.Code,
        prospect.Country,
        StringComparison.OrdinalIgnoreCase))?.DisplayName ?? prospect.Country)
                    </td>


                    <td class="fw-semibold">
                        @prospect.ProspectName
                    </td>


                    <td class="text-nowrap">
                        @prospect.ProspectType
                    </td>

		    <td>
                         @prospect.Industry
                    </td>


                    <!-- Customer Status -->
                    <td class="text-center text-nowrap">

                        @if (prospect.UbaCustomer == "Yes")
                        {
                            <span class="badge bg-success">
                                Converted Customer
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Active Prospect
                            </span>
                        }

                    </td>


                    <!-- Acquisition Status -->
                    <td class="text-nowrap">

                        @switch (prospect.AcquisitionStatus)
                        {
                            case "New":
                                <span class="badge bg-secondary">
                                    New
                                </span>
                                break;

                            case "Contacted":
                                <span class="badge bg-primary">
                                    Contacted
                                </span>
                                break;

                            case "Engaged":
                                <span class="badge bg-info text-dark">
                                    Engaged
                                </span>
                                break;

                            case "Interested":
                                <span class="badge bg-success">
                                    Interested
                                </span>
                                break;

                            case "Not Interested":
                                <span class="badge bg-warning text-dark">
                                    Not Interested
                                </span>
                                break;

                            case "Lost":
                                <span class="badge bg-danger">
                                    Lost
                                </span>
                                break;

                            case "Converted":
                                <span class="badge bg-success">
                                    Converted
                                </span>
                                break;

                            default:
                                <span class="badge bg-secondary">
                                    @prospect.AcquisitionStatus
                                </span>
                                break;
                        }

                    </td>


		    <!-- Funded -->
                    <td class="text-center text-nowrap">
                     @prospect.Funded
                    </td>

                    <!-- Marketed By -->
                    <td>
                        @prospect.MarketedBy
                    </td>


                    <!-- Marketed Date -->
                    <td class="text-nowrap">
                        @(prospect.MarketedDate?.ToString("dd-MMM-yyyy"))
                    </td>

		    <td class="text-nowrap">
    @prospect.BranchId
</td>

<td class="text-nowrap">
    @prospect.UploadedDate?.ToString("dd-MMM-yyyy")
</td>

<td class="text-nowrap">
    @prospect.ConvertedDate?.ToString("dd-MMM-yyyy")
</td>

<td class="text-center text-nowrap">
    @if (prospect.UploadedDate.HasValue &&
         prospect.ConvertedDate.HasValue)
    {
        @((prospect.ConvertedDate.Value.Date -
           prospect.UploadedDate.Value.Date).Days)
    }
    else
    {
        <span class="text-muted">—</span>
    }
</td>

                    <td style="min-width: 220px; max-width: 300px;">
                        @prospect.Address
                    </td>


                    <td class="text-nowrap">
                        @prospect.State
                    </td>


                    <td class="text-nowrap">
                        @prospect.Region
                    </td>


                    <td class="text-nowrap">
                        @prospect.Phone
                    </td>


                    <td class="text-nowrap">
                        @prospect.Email
                    </td>


                    <!-- Actions -->
                   <td class="text-center text-nowrap actions-column">

                   <a href="https://www.google.com/search?q=@Uri.EscapeDataString(
                   prospect.ProspectType?.Equals("Corporate", StringComparison.OrdinalIgnoreCase) == true
                   ? $"{prospect.CompanyName} {prospect.Country}"
                   : $"{prospect.ProspectName} {prospect.CompanyName} {prospect.Country}")"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-sm btn-outline-info">
                       Web Search
                   </a>


		   @if (prospect.UbaCustomer == "Yes")
{
    <a href="#"
       class="btn btn-sm btn-outline-secondary disabled"
       aria-disabled="true"
       tabindex="-1">
        Convert
    </a>
}
else
{
    <a asp-controller="Prospect"
       asp-action="ConvertToCustomer"
       asp-route-id="@prospect.Id"
       class="btn btn-sm btn-outline-success">
        Convert
    </a>
}

                        <a asp-action="Edit"
                           asp-route-id="@prospect.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@prospect.Id"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="14"
                    class="text-center py-4 text-muted">

                    No prospects found.

                </td>

            </tr>
        }

    </tbody>

</table>

            </div>

        </div>

    </div>

</div>


<!-- Record Count -->
@if (Model != null && Model.TotalCount > 0)
{
    var startRecord =
        ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var endRecord =
        Math.Min(
            Model.PageNumber * Model.PageSize,
            Model.TotalCount);

    <div class="text-muted text-center mt-3">

        Showing @startRecord–@endRecord
        of @Model.TotalCount records

    </div>
}


<!-- Pagination -->
@if (Model != null && Model.TotalPages > 1)
{
    <nav class="mt-4">

        <ul class="pagination justify-content-center">


            <!-- Previous -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-country="@ViewBag.Country"
                   asp-route-region="@ViewBag.Region"
                   asp-route-prospectType="@ViewBag.ProspectType"
		   asp-route-industry="@ViewBag.Industry"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-sortColumn="@ViewBag.SortColumn"
                   asp-route-sortDirection="@ViewBag.SortDirection">

                    Previous

                </a>

            </li>


            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchTerm="@ViewBag.SearchTerm"
                       asp-route-country="@ViewBag.Country"
                       asp-route-region="@ViewBag.Region"
                       asp-route-prospectType="@ViewBag.ProspectType"
		       asp-route-industry="@ViewBag.Industry"
                       asp-route-pageNumber="@i"
                       asp-route-sortColumn="@ViewBag.SortColumn"
                       asp-route-sortDirection="@ViewBag.SortDirection">

                        @i

                    </a>

                </li>
            }


            <!-- Next -->
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-country="@ViewBag.Country"
                   asp-route-region="@ViewBag.Region"
                   asp-route-prospectType="@ViewBag.ProspectType"
		   asp-route-industry="@ViewBag.Industry"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-sortColumn="@ViewBag.SortColumn"
                   asp-route-sortDirection="@ViewBag.SortDirection">

                    Next

                </a>

            </li>

        </ul>

    </nav>
}

<style>
    .table-responsive {
        overflow-x: auto;
    }

    .actions-column {
        position: sticky;
        right: 0;
        z-index: 2;
        background-color: white;
        min-width: 220px;
        box-shadow: -4px 0 6px rgba(0, 0, 0, 0.08);
    }

    thead .actions-column {
        background-color: #dc1a0c;
        color: white;
        z-index: 3;
    }

    tbody tr:nth-child(even) .actions-column {
        background-color: #f2f2f2;
    }

    tbody tr:nth-child(odd) .actions-column {
        background-color: white;
    }
</style>
