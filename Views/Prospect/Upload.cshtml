@{
    ViewData["Title"] = "Upload Prospects";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header bg-white">
                    <h4 class="mb-0">Upload Prospects</h4>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        Upload an Excel file containing prospect information.
                    </p>

                    <form asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

			    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label class="form-label">
                                Select Excel File
                            </label>

                            <input type="file"
                                   name="file"
                                   class="form-control"
                                   accept=".xlsx" />

                            <div class="form-text">
                                Only Excel (.xlsx) files are allowed.
                            </div>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Upload File
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
