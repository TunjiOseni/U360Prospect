@{
    ViewData["Title"] = "Upload Prospects";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header bg-white">
                    <h4 class="mb-0">Upload Prospects</h4>
                </div>

                <div class="card-body">

                    <div class="mb-3">
    <label for="defaultCountry" class="form-label">
        Default Country for Blank Country Cells
    </label>

    <select id="defaultCountry"
            name="defaultCountry"
            class="form-select"
            required>
        <option value="">-- Select Country --</option>

        @foreach (var item in ViewBag.Countries)
        {
            <option value="@item.Code"
                    selected="@(item.Code == "NG")">
                @item.DisplayName
            </option>
        }
    </select>

    <div class="form-text">
        Used only when the Excel COUNTRY cell is blank.
        Existing country values will be validated separately.
    </div>
</div>

                    <form asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

			    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label for="defaultCountry" class="form-label">
        Default Country for Blank Country Cells
    </label>

    <select id="defaultCountry"
            name="defaultCountry"
            class="form-select"
            required>
        <option value="">-- Select Country --</option>

        @foreach (var item in ViewBag.Countries)
        {
            <option value="@item.Code">
                @item.DisplayName
            </option>
        }
    </select>

    <div class="form-text">
        Used when the Excel COUNTRY cell is blank.
    </div>
</div>                        <div class="mb-3">

                            <label class="form-label">
                                Select Excel File
                            </label>

                            <input type="file"
                                   name="file"
                                   class="form-control"
                                   accept=".xlsx" />

                            <div class="form-text">
                                Only Excel (.xlsx) files are allowed.
                            </div>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Upload File
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
