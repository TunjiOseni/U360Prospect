@model U360Prospect.Models.Prospect

<h1>Delete Prospect</h1>

<div class="alert alert-warning">
    <strong>Warning!</strong> Are you sure you want to delete this prospect?
</div>

<div class="card">
    <div class="card-body">

        <h4>@Model.ProspectName</h4>

        <p><strong>Industry:</strong> @Model.Industry</p>

        <p><strong>Company Type:</strong> @Model.CompanyType</p>

        <p><strong>Region:</strong> @Model.Region</p>

    </div>
</div>

<br />

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Yes, Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
