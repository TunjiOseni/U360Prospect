
@model U360Prospect.Models.Api.CreateRoleRequest

@{
    ViewData["Title"] = "Create Role";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Create Application Role</h3>
            <p class="text-muted mb-0">
                Define a new role for U360Prospect.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Roles
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RoleName" class="form-label">
                        Role Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="RoleName"
                           class="form-control"
                           placeholder="e.g. AUDITOR" />

                    <span asp-validation-for="RoleName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the purpose of this role"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    Creating a role does not automatically assign it to users.
                    User-role assignments are managed separately.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Create Role
                    </button>

                    <a asp-action="Index" class="btn btn-light">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
