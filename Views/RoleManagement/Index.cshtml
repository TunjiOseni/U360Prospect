
@model List<U360Prospect.Models.Api.RoleDetailsResponse>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Role Management</h3>
            <p class="text-muted mb-0">
                Manage application roles and access permissions.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Create Role
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Role ID</th>
                            <th>Role Name</th>
                            <th>Description</th>
                            <th>Assigned Users</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr>
                                    <td>@role.RoleId</td>
                                    <td>
                                        <strong>@role.RoleName</strong>
                                    </td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(role.Description)
                                            ? "No description"
                                            : role.Description)
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @role.AssignedUsersCount
                                        </span>
                                    </td>
                                    <td>
                                        @role.CreatedAt.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                       <a asp-controller="RoleManagement"
   asp-action="Details"
   asp-route-id="@role.RoleId"
   class="btn btn-sm btn-outline-primary">
    View
</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No application roles found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
