
@{
    ViewData["Title"] = "Welcome to U360Prospect";
}

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-9">

            <h1 class="display-4 fw-bold mb-3">
                Welcome to U360Prospect
            </h1>

            <p class="lead text-muted mb-4">
                Prospect and Customer Acquisition Management
            </p>

            <p class="mb-5">
                Access the U360Prospect application to manage prospects,
                customer acquisition activities and related business operations.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary btn-lg px-5">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Login
            </a>

        </div>
    </div>
</div>
