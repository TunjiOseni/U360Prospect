<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - U360Prospect</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/U360Prospect.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- UBA STYLE HEADER -->
    <header>

        <nav class="navbar navbar-expand-lg uba-navbar">

            <div class="container-fluid px-4">

                <!-- Application Branding -->
                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/uba-logo.png"
                         alt="UBA"
                         class="uba-logo" />

                    <span class="uba-brand-text">
                        <span class="uba-app-name">
                            U360Prospect
                        </span>

                        <span class="uba-app-subtitle">
                            Prospect &amp; Customer Acquisition Management
                        </span>
                    </span>

                </a>
                <!-- Mobile Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


<!-- Navigation -->
<div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

    <div class="d-flex flex-column align-items-end w-100">

        <!-- Main Navigation Row -->
        <ul class="navbar-nav flex-row align-items-center gap-3">

            <li class="nav-item">
                <a class="nav-link uba-nav-link"
                   asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>
            </li>

            <!-- Keep your existing Prospects navigation link here -->

            @if (User.Identity?.IsAuthenticated == true &&
                 User.IsInRole("ADMIN"))
            {
                <li class="nav-item dropdown">

                    <a class="nav-link dropdown-toggle text-white"
                       href="#"
                       id="administrationDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        Administration
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end"
                        aria-labelledby="administrationDropdown">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="UserManagement"
                               asp-action="Index">
                                User Management
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="RoleManagement"
                               asp-action="Index">
                                Role Management
                            </a>
                        </li>

			<li>
    <a class="dropdown-item"
       asp-controller="AuditHistory"
       asp-action="Index">
        Audit History
    </a>
</li>

                    </ul>
                </li>
            }

           @if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        <a class="nav-link uba-nav-link"
           asp-controller="Prospect"
           asp-action="Index">
            Prospects
        </a>
    </li>
}

        </ul>

        <!-- Logged-in Information Row -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex align-items-center gap-3 mt-1">

                <span class="text-white small">
                    Logged in:
                    @(User.Identity.Name?.Split('\\').LastOrDefault() ?? "Unknown")
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-link text-white p-0 small">
                        Logout
                    </button>

                </form>

            </div>
        }

    </div>

</div>

    </header>


    <!-- MAIN CONTENT -->

    <main role="main">

        <div class="container-fluid px-4 py-4">

            @RenderBody()

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="uba-footer">

        <div class="container-fluid px-4">

            <div class="d-flex justify-content-between align-items-center">

                <span>
                    © 2026 U360Prospect
                </span>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

            </div>

        </div>

    </footer>


    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
