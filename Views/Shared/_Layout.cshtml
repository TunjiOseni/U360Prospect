<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - U360Prospect</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/U360Prospect.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- UBA STYLE HEADER -->
    <header>

        <nav class="navbar navbar-expand-lg uba-navbar">

            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/uba-logo.png"
                         alt="UBA"
                         class="uba-logo" />

                    <span class="uba-app-name">
                        U360Prospect
                    </span>

                </a>

                <!-- Mobile Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link uba-nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link uba-nav-link"
                               asp-area=""
                               asp-controller="Prospect"
                               asp-action="Index">
                                Prospects
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link uba-nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- MAIN CONTENT -->

    <main role="main">

        <div class="container-fluid px-4 py-4">

            @RenderBody()

        </div>

    </main>


    <!-- FOOTER -->

    <footer class="uba-footer">

        <div class="container-fluid px-4">

            <div class="d-flex justify-content-between align-items-center">

                <span>
                    © 2026 U360Prospect
                </span>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy
                </a>

            </div>

        </div>

    </footer>


    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
