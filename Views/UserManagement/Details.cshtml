@model U360Prospect.Models.Api.UserDetailsResponse

@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>User Details</h3>
            <p class="text-muted mb-0">
                View registered user information and access.
            </p>
        </div>

<div class="d-flex gap-2 flex-wrap">

    <a asp-controller="UserManagement"
       asp-action="Edit"
       asp-route-id="@Model.UserId"
       class="btn btn-primary">
        Edit User
    </a>

    @if (Model.IsActive)
    {
        <a asp-controller="UserManagement"
           asp-action="Deactivate"
           asp-route-id="@Model.UserId"
           class="btn btn-danger">
            Deactivate User
        </a>
    }
    else
    {
        <a asp-controller="UserManagement"
           asp-action="Reactivate"
           asp-route-id="@Model.UserId"
           class="btn btn-success">
            Reactivate User
        </a>
    }

        <a asp-controller="UserManagement"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Users
    </a>

</div>
</div>

<div class="card shadow-sm">


        <div class="card-header">
            <strong>Account Information</strong>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>

                <dt class="col-sm-3">Display Name</dt>
                <dd class="col-sm-9">@Model.DisplayName</dd>

                <dt class="col-sm-3">Account Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Assigned Roles</dt>
<dd class="col-sm-9">
    @if (Model.Roles.Any())
    {
        foreach (var role in Model.Roles)
        {
            <div class="d-inline-flex align-items-center me-2 mb-2">
                <span class="badge bg-info text-dark me-2">
                    @role
                </span>

                <form asp-controller="UserManagement"
                      asp-action="RemoveRole"
                      asp-route-id="@Model.UserId"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="roleName"
                           value="@role" />

                    <button type="submit"
                            class="btn btn-sm btn-outline-danger"
                            onclick="return confirm('Remove this role from the user?');">
                        Remove
                    </button>
                </form>
            </div>
        }
    }
    else
    {
        <span class="text-muted">No roles assigned</span>
    }
</dd>

                <dt class="col-sm-3">Date Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Last Login</dt>
                <dd class="col-sm-9">
                    @(Model.LastLoginDate?.ToString("dd-MMM-yyyy HH:mm") ?? "Never")
                </dd>

            </dl>

        </div>
@if (Model.IsActive)
{
    var availableRoles =
        ViewBag.AvailableRoles as
        List<U360Prospect.Models.Api.RoleDetailsResponse>;

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <strong>Assign Application Role</strong>
        </div>

        <div class="card-body">

            @if (availableRoles != null &&
                 availableRoles.Any(r =>
                     !Model.Roles.Contains(
                         r.RoleName,
                         StringComparer.OrdinalIgnoreCase)))
            {
                <form asp-controller="UserManagement"
                      asp-action="AssignRole"
                      asp-route-id="@Model.UserId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row align-items-end">

                        <div class="col-md-6">
                            <label class="form-label">
                                Select Role
                            </label>

                            <select name="RoleName"
                                    class="form-select"
                                    required>
                                <option value="">-- Select Role --</option>

                                @foreach (var role in availableRoles.Where(r =>
                                    !Model.Roles.Contains(
                                        r.RoleName,
                                        StringComparer.OrdinalIgnoreCase)))
                                {
                                    <option value="@role.RoleName">
                                        @role.RoleName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <button type="submit"
                                    class="btn btn-primary">
                                Assign Role
                            </button>
                        </div>

                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">
                    No additional roles are available for assignment.
                </p>
            }

        </div>
    </div>
}
    </div>

</div>
