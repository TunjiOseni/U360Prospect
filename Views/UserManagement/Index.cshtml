@model List<U360Prospect.Models.Api.UserDetailsResponse>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>User Management</h3>
            <p class="text-muted mb-0">
                Manage application users and their access.
            </p>
        </div>

        <a asp-controller="UserManagement"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Create User
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Username</th>
                            <th>Display Name</th>
                            <th>Assigned Roles</th>
                            <th>Status</th>
                            <th>Date Created</th>
                            <th>Last Login</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Username</td>

                                    <td>@user.DisplayName</td>

                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-info text-dark me-1">
                                                    @role
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No role</span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        @user.CreatedAt.ToString("dd-MMM-yyyy")
                                    </td>

                                    <td>
                                        @(user.LastLoginDate?.ToString("dd-MMM-yyyy HH:mm") ?? "Never")
                                    </td>

                                    <td>
                                        <a asp-controller="UserManagement"
   asp-action="Details"
   asp-route-id="@user.UserId"
   class="btn btn-sm btn-outline-primary">
    View
</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
