
@model U360Prospect.Models.Api.CreateUserRequest

@{
    ViewData["Title"] = "Create User";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Create Application User</h3>
            <p class="text-muted mb-0">
                Register a user and grant the default application access.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Users
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">
                        Windows Username <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Username"
                           class="form-control"
                           placeholder="e.g. john.doe" />

                    <span asp-validation-for="Username"
                          class="text-danger"></span>

                    <small class="text-muted">
                        Enter the username without the domain prefix or email address.
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label">
                        Display Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="DisplayName"
                           class="form-control"
                           placeholder="Enter user's full name" />

                    <span asp-validation-for="DisplayName"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    <strong>Default access:</strong>
                    The user will initially be assigned the standard USER role.
                    Additional roles can be assigned later by an administrator.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Create User
                    </button>

                    <a asp-action="Index" class="btn btn-light">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
